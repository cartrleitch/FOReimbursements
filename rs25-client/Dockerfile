FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ARG REACT_APP_BUG_REPORT_EMAIL
ENV REACT_APP_BUG_REPORT_EMAIL=$REACT_APP_BUG_REPORT_EMAIL
ARG REACT_APP_REIMBURSEMENT_REPORT_EMAIL
ENV REACT_APP_REIMBURSEMENT_REPORT_EMAIL=$REACT_APP_REIMBURSEMENT_REPORT_EMAIL
RUN npm install --legacy-peer-deps
COPY . .
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
